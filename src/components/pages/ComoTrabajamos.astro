---
// Cómo trabajamos (ES y EN), portada de legacy/Structura V2 - Como Trabajamos
// Content.dc.html. El hero arranca con el fondo CSS animado de respaldo; el
// shader WebGPU que entra encima es de la Fase 4. Los pasos pasaron de <h3>
// a <h2> (la página no tenía ningún <h2> antes) con el mismo estilo.
import Base from '../../layouts/Base.astro';
import { waLink } from '../../config/site';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const c = d.comoTrabajamos;
const ultimo = c.steps.length - 1;
---
<Base lang={lang} route="comoTrabajamos" title={d.seo.comoTrabajamos.title} description={d.seo.comoTrabajamos.description}>
  <div style="position:relative;width:100%;font-family:'IBM Plex Sans',sans-serif;background:#0A0E13;color:#E7ECEF;overflow-x:hidden;">

    <section style="position:relative;overflow:hidden;padding:100px 5% 80px;text-align:center;">
      <div aria-hidden="true" style="position:absolute;inset:0;z-index:0;">
        <div class="cw-fallback">
          <div class="cw-fallback__glow"></div>
          <div class="cw-fallback__ribs"></div>
          <div class="hero-grain"></div>
        </div>
        <canvas id="cw-hero-shader" class="hero-shader" style="position:absolute;inset:0;width:100%;height:100%;display:block;"></canvas>
      </div>
      <div style="position:relative;z-index:1;max-width:900px;margin:0 auto;">
        <p style="font-family:'IBM Plex Mono',monospace;font-size:13px;color:#2DD4FF;letter-spacing:0.04em;margin:0 0 18px;">{c.eyebrow}</p>
        <h1 style="font-size:clamp(32px,5vw,54px);font-weight:600;letter-spacing:-0.01em;margin:0 0 20px;">{c.title}</h1>
        <p style="color:#7C8894;font-size:17px;line-height:1.6;max-width:560px;margin:0 auto;">{c.sub}</p>
      </div>
    </section>

    <section style="padding:0 5% 120px;max-width:900px;margin:0 auto;display:flex;flex-direction:column;gap:0;">
      {c.steps.map((s, i) => (
        <div style={`display:grid;grid-template-columns:80px 1fr;gap:28px;padding:36px 0;border-top:1px solid #232B35;${i === ultimo ? 'border-bottom:1px solid #232B35;' : ''}`}>
          <div aria-hidden="true" style="font-family:'IBM Plex Mono',monospace;font-size:36px;font-weight:700;color:#232B35;">{String(i + 1).padStart(2, '0')}</div>
          <div>
            <p style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:#2DD4FF;margin:0 0 8px;">{s.phase}</p>
            <h2 style="margin:0 0 10px;font-size:22px;font-weight:600;">{s.title}</h2>
            <p style="color:#7C8894;font-size:15px;line-height:1.65;margin:0;max-width:560px;">{s.desc}</p>
          </div>
        </div>
      ))}
    </section>

    <section style="padding:0 5% 120px;text-align:center;max-width:760px;margin:0 auto;">
      <h2 style="font-size:clamp(26px,3.6vw,38px);font-weight:600;letter-spacing:-0.01em;margin:0 0 18px;">{c.ctaTitle}</h2>
      <p style="color:#7C8894;font-size:16px;line-height:1.6;margin:0 0 32px;">{c.ctaSub}</p>
      <a href={waLink} target="_blank" rel="noopener" style="display:inline-flex;background:#2DD4FF;color:#0A0E13;padding:17px 36px;border-radius:8px;font-size:16px;font-weight:600;">{c.ctaBtn}</a>
    </section>

  </div>
</Base>

<script>
  import { montarShader } from '../../scripts/shader';

  // Shader WebGPU del hero (mismo preset que el sitio viejo). Cuando está en
  // pantalla se oculta el fondo de respaldo y el hero toma los toques (el
  // shader reacciona al dedo) en vez de dejar hacer scroll táctil.
  const canvas = document.querySelector<HTMLCanvasElement>('#cw-hero-shader');
  const respaldo = document.querySelector('.cw-fallback');
  const hero = canvas?.closest('section');
  const listo = (si: boolean) => {
    canvas?.classList.toggle('is-ready', si);
    respaldo?.classList.toggle('is-hidden', si);
    hero?.classList.toggle('hero-touch-lock', si);
  };
  montarShader(canvas, {
      components: [
        {
          type: 'Swirl',
          props: { colorA: '#0A0E13', colorB: '#101720', detail: 1.7 }
        },
        {
          type: 'ChromaFlow',
          props: {
            baseColor: '#0A0E13',
            downColor: '#2DD4FF',
            leftColor: '#56c2fc',
            rightColor: '#0FA8CE',
            upColor: '#7FE6FF',
            momentum: 13,
            radius: 3.5
          }
        },
        {
          type: 'FlutedGlass',
          props: {
            aberration: 0.61,
            angle: 31,
            frequency: 8,
            highlight: 0.12,
            highlightSoftness: 0,
            lightAngle: -90,
            refraction: 4,
            shape: 'rounded',
            softness: 1,
            speed: 0.15
          }
        },
        {
          type: 'FilmGrain',
          props: { strength: 0.05 }
        }
      ]
    }, { listo: () => listo(true), error: () => listo(false) });
</script>
