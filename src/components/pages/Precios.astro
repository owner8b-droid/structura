---
// Precios (ES y EN), portada de legacy/Structura V2 - Precios Content.dc.html.
// El shader WebGPU de la tarjeta Pro se monta en la Fase 4; hasta entonces el
// <canvas> queda vacío, como en navegadores sin WebGPU. Los títulos de plan
// pasaron de <h3> a <h2> (no había ningún <h2> encima) con el mismo estilo.
import Base from '../../layouts/Base.astro';
import { waLink } from '../../config/site';
import { t, path, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const p = d.precios;
const check = (color: string) => `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="flex-shrink:0;margin-top:2px;"><path d="M13.5 4.5L6 12L2.5 8.5" stroke="${color}" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const itemStyle = (i: number, total: number) => `display:flex;gap:12px;${i < total - 1 ? 'margin-bottom:12px;' : ''}`;
---
<Base lang={lang} route="precios" title={d.seo.precios.title} description={d.seo.precios.description}>
  <div style="position:relative;width:100%;font-family:'IBM Plex Sans',sans-serif;background:#0A0E13;color:#E7ECEF;overflow-x:hidden;">

    <section style="padding:100px 5% 60px;text-align:center;">
      <div class="pricing-reveal" style="max-width:640px;margin:0 auto;">
        <p style="font-family:'IBM Plex Mono',monospace;font-size:13px;color:#2DD4FF;letter-spacing:0.04em;margin:0 0 18px;">{p.eyebrow}</p>
        <h1 style="font-size:clamp(32px,5vw,54px);font-weight:600;letter-spacing:-0.01em;margin:0 0 20px;">{p.title}</h1>
        <p style="color:#7C8894;font-size:17px;line-height:1.6;margin:0;">{p.sub} <em style="color:#7C8894;font-style:normal;">{p.subEm}</em></p>
      </div>
    </section>

    <section style="padding:0 5% 120px;max-width:1100px;margin:0 auto;">

      <div class="pricing-grid pricing-reveal" style="margin-top:8px;animation-delay:.18s;">

        <div class="pricing-card pricing-card--edge" style="display:flex;flex-direction:column;justify-content:space-between;border-radius:20px;background:#10161D;border:1px solid #232B35;padding:32px;">
          <div>
            <h2 style="margin:0;font-size:18px;font-weight:600;">{p.essential.title}</h2>
            <p style="margin:4px 0 0;font-size:14px;color:#7C8894;">{p.essential.desc}</p>
            <div style="display:flex;align-items:baseline;gap:8px;margin-top:24px;">
              <span style="font-size:36px;font-weight:600;letter-spacing:-0.02em;">{p.essential.priceFigure}</span>
              <span style="font-size:14px;color:#7C8894;">{p.essential.priceSuffix}</span>
            </div>
            <ul role="list" style="list-style:none;margin:32px 0 0;padding:0;font-size:14px;">
              {p.essential.features.map((f, i) => <li style={itemStyle(i, p.essential.features.length)}><Fragment set:html={check('#2DD4FF')} /><span style="color:#C9CFD6;">{f}</span></li>)}
            </ul>
          </div>
          <a href={waLink} target="_blank" rel="noopener" class="pricing-cta" style="display:block;margin-top:40px;border-radius:10px;padding:11px 0;text-align:center;font-size:14px;font-weight:600;border:1px solid #232B35;color:#E7ECEF;">{p.essential.cta}</a>
        </div>

        <div class="pricing-card pricing-card--scale" style="position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;border-radius:20px;background:#050709;color:#fff;padding:32px;box-shadow:0 30px 70px -25px rgba(45,212,255,0.35);">
          <div aria-hidden="true" class="pricing-scale-bg" style="position:absolute;inset:0;">
            <canvas id="pricing-scale-shader" style="position:absolute;inset:0;width:100%;height:100%;display:block;"></canvas>
          </div>
          <div aria-hidden="true" style="position:absolute;inset:0;border-radius:20px;box-shadow:inset 0 0 0 1px rgba(255,255,255,0.1);pointer-events:none;"></div>

          <div style="position:relative;">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
              <h2 style="margin:0;font-size:18px;font-weight:600;">{p.scale.title}</h2>
              <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.04em;color:#7FE6FF;white-space:nowrap;">{p.scale.badge}</span>
            </div>
            <p style="margin:4px 0 0;font-size:14px;color:rgba(255,255,255,0.6);">{p.scale.desc}</p>
            <div style="display:flex;align-items:baseline;gap:8px;margin-top:24px;">
              <span style="font-size:36px;font-weight:600;letter-spacing:-0.02em;">{p.scale.priceFigure}</span>
              <span style="font-size:14px;color:rgba(255,255,255,0.6);">{p.scale.priceSuffix}</span>
            </div>
            <ul role="list" style="list-style:none;margin:32px 0 0;padding:0;font-size:14px;">
              {p.scale.features.map((f, i) => <li style={itemStyle(i, p.scale.features.length)}><Fragment set:html={check('#7FE6FF')} /><span style="color:rgba(255,255,255,0.75);">{f}</span></li>)}
            </ul>
          </div>
          <a href={waLink} target="_blank" rel="noopener" class="pricing-cta pricing-cta--primary" style="position:relative;display:block;margin-top:40px;border-radius:10px;padding:11px 0;text-align:center;font-size:14px;font-weight:600;background:#2DD4FF;color:#0A0E13;">{p.scale.cta}</a>
        </div>

        <div class="pricing-card pricing-card--edge" style="display:flex;flex-direction:column;justify-content:space-between;border-radius:20px;background:#10161D;border:1px solid #232B35;padding:32px;">
          <div>
            <h2 style="margin:0;font-size:18px;font-weight:600;">{p.custom.title}</h2>
            <p style="margin:4px 0 0;font-size:14px;color:#7C8894;">{p.custom.desc}</p>
            <div style="display:flex;align-items:baseline;gap:8px;margin-top:24px;">
              <span style="font-size:36px;font-weight:600;letter-spacing:-0.02em;">{p.custom.priceFigure}</span>
              <span style="font-size:14px;color:#7C8894;">{p.custom.priceSuffix}</span>
            </div>
            <ul role="list" style="list-style:none;margin:32px 0 0;padding:0;font-size:14px;">
              {p.custom.features.map((f, i) => <li style={itemStyle(i, p.custom.features.length)}><Fragment set:html={check('#2DD4FF')} /><span style="color:#C9CFD6;">{f}</span></li>)}
            </ul>
          </div>
          <a href={waLink} target="_blank" rel="noopener" class="pricing-cta" style="display:block;margin-top:40px;border-radius:10px;padding:11px 0;text-align:center;font-size:14px;font-weight:600;border:1px solid #232B35;color:#E7ECEF;">{p.custom.cta}</a>
        </div>

      </div>

      <div class="pricing-reveal" style="margin-top:48px;display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:16px;border-top:1px solid #232B35;padding-top:32px;font-size:14px;color:#7C8894;animation-delay:.3s;">
        <p style="margin:0;max-width:640px;">{p.footnote} <a href={waLink} target="_blank" rel="noopener" style="font-weight:500;">{p.footnoteLink}</a>.</p>
        <a href={path('contacto', lang)} style="font-weight:500;color:#E7ECEF;">{p.detailLink} →</a>
      </div>

    </section>

    <section style="padding:0 5% 120px;text-align:center;max-width:760px;margin:0 auto;">
      <h2 style="font-size:clamp(26px,3.6vw,38px);font-weight:600;letter-spacing:-0.01em;margin:0 0 18px;">{p.finalCtaTitle}</h2>
      <p style="color:#7C8894;font-size:16px;line-height:1.6;margin:0 0 32px;">{p.finalCtaSub}</p>
      <a href={waLink} target="_blank" rel="noopener" style="display:inline-flex;background:#2DD4FF;color:#0A0E13;padding:17px 36px;border-radius:8px;font-size:16px;font-weight:600;">{p.finalCtaBtn}</a>
    </section>

  </div>
</Base>

<script>
  import { montarShader } from '../../scripts/shader';

  // Shader WebGPU de la tarjeta Pro (mismo preset que el sitio viejo). En
  // celular no se monta (ver montarShader): ahí queda el fondo CSS.
  montarShader(document.querySelector<HTMLCanvasElement>('#pricing-scale-shader'), {
      components: [
        {
          type: 'LinearGradient',
          props: {
            colorSpace: 'oklab',
            start: { x: 0.5, y: 1 },
            end: { x: 0.5, y: 0 },
            stops: [
              { color: '#0f1a24', position: 0 },
              { color: '#05070a', position: 1 }
            ]
          }
        },
        {
          type: 'Heatmap',
          props: {
            center: { x: 0.6, y: 0.9 },
            scale: 0.55,
            shape: JSON.stringify({
              type: 'gem3D', radius: 0.3, height: 0.32, facets: 10, rotX: 15,
              rotY: { type: 'mouse', axis: 'x', outputMin: -16, outputMax: 16, curve: 0 },
              rotZ: { type: 'mouse', axis: 'y', outputMin: -5, outputMax: 5, curve: 0 }
            }),
            shapeType: 'gem3D',
            stops: [
              { color: '#02040a', position: 0 },
              { color: '#0a2a4a', position: 0.2 },
              { color: '#0e5f8f', position: 0.45 },
              { color: '#17b8d8', position: 0.7 },
              { color: '#7FE6FF', position: 0.9 },
              { color: '#ffffff', position: 1 }
            ]
          }
        },
        {
          type: 'Vignette',
          props: { color: '#05070a', center: { x: 0.5, y: 0.5 }, radius: 0.62, falloff: 0.55, intensity: 0.85 }
        },
        {
          type: 'FilmGrain',
          props: { strength: 0.05 }
        }
      ]
    });
</script>
