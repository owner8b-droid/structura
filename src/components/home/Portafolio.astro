---
// Carrusel de logos, portado de legacy/Structura V2 - Home Content.dc.html.
// Al pasar el mouse por un logo aparece encima una vista previa con el video
// del proyecto (data-video). La segunda vuelta repite los logos para que el
// marquee no tenga corte, y queda oculta para lectores de pantalla.
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang).home.portafolio;

const clientes = [
  { img: '/assets/folio/haus.png', name: 'Haus', video: '/assets/folio/videos/haus.mp4' },
  { img: '/assets/folio/hesa.png', name: 'Hesa', video: '/assets/folio/videos/hesa.mp4' },
  { img: '/assets/folio/aaec.png', name: 'AAEC', video: '/assets/folio/videos/aaec.mp4' },
  { img: '/assets/folio/rloria.png', name: 'R. Loría Abogados', video: '/assets/folio/videos/rloria.mp4' },
  { img: '/assets/folio/alturaraiz.png', name: 'Altura Raíz', video: '/assets/folio/videos/alturaraiz.mp4' },
  { img: '/assets/folio/evoke.png', name: 'Evoke', video: '/assets/folio/videos/evoke.mp4' },
  { img: '/assets/folio/pastoarca.png', name: 'Pasto Arca', video: '/assets/folio/videos/pastoarca.mp4' },
  { img: '/assets/folio/zacate.png', name: 'Zacate Tierra Fértil', video: '/assets/folio/videos/zacate.mp4' },
];
---
<section id="portafolio" style="padding:0 0 120px;">
  <div style="padding:0 5%;max-width:1240px;margin:0 auto;">
    <p style="font-family:'IBM Plex Mono',monospace;font-size:13px;color:#2DD4FF;letter-spacing:0.04em;margin:0 0 14px;">{d.eyebrow}</p>
    <h2 style="font-size:clamp(28px,4vw,44px);font-weight:600;letter-spacing:-0.01em;margin:0 0 16px;max-width:640px;">{d.title}</h2>
    <p style="color:#7C8894;font-size:17px;max-width:600px;line-height:1.6;margin:0 0 56px;">{d.sub}</p>
  </div>
  <div class="folio-track">
    <div class="folio-marquee" style="display:inline-flex;align-items:center;gap:76px;">
      {[false, true].flatMap((copia) => clientes.map((c) => (
        <span class="folio-logo-wrap" data-name={c.name} data-video={c.video} aria-hidden={copia ? 'true' : undefined}>
          <img src={c.img} alt={copia ? '' : d.logoAlt.replace('{name}', c.name)} class="folio-logo" />
        </span>
      )))}
    </div>
  </div>

  <div class="folio-preview" aria-hidden="true" hidden>
    <div style="display:flex;gap:5px;padding:8px 10px;border-bottom:1px solid #232B35;">
      <span style="width:6px;height:6px;border-radius:50%;background:#FF5F57;"></span>
      <span style="width:6px;height:6px;border-radius:50%;background:#FEBC2E;"></span>
      <span style="width:6px;height:6px;border-radius:50%;background:#28C840;"></span>
    </div>
    <div class="folio-preview__viewport">
      <video muted loop playsinline preload="none" style="width:100%;height:100%;object-fit:cover;display:block;"></video>
      <div class="folio-preview__pronto" hidden>
        <div class="folio-preview__scroll">
          <div style="display:flex;align-items:center;gap:6px;"><span style="width:16px;height:16px;border-radius:4px;background:#232B35;"></span><span style="height:6px;width:38%;background:#232B35;border-radius:3px;"></span></div>
          <span style="height:7px;width:70%;background:#232B35;border-radius:4px;"></span>
          <span style="height:7px;width:50%;background:#232B35;border-radius:4px;"></span>
          <div style="display:flex;gap:6px;"><i style="flex:1;height:26px;background:#161D26;border:1px solid #232B35;border-radius:6px;"></i><i style="flex:1;height:26px;background:#161D26;border:1px solid #232B35;border-radius:6px;"></i></div>
          <span style="height:6px;width:60%;background:#232B35;border-radius:3px;"></span>
          <div style="display:flex;gap:6px;"><i style="flex:1;height:26px;background:#161D26;border:1px solid #232B35;border-radius:6px;"></i><i style="flex:1;height:26px;background:#161D26;border:1px solid #232B35;border-radius:6px;"></i></div>
        </div>
        <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(10,14,19,0.35);">
          <span style="font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:0.03em;color:#7C8894;background:#10161D;border:1px solid #232B35;padding:4px 9px;border-radius:20px;">{d.previewSoon}</span>
        </div>
      </div>
    </div>
    <div class="folio-preview__nombre" style="padding:10px 12px;font-size:12.5px;font-weight:600;color:#E7ECEF;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"></div>
  </div>
</section>

<script>
  // Vista previa del proyecto al pasar el mouse por un logo, como en el sitio
  // viejo: aparece encima del logo y reproduce su video (o el aviso de
  // "video próximamente" si no tiene).
  const preview = document.querySelector<HTMLElement>('.folio-preview');
  const video = preview?.querySelector('video');
  const pronto = preview?.querySelector<HTMLElement>('.folio-preview__pronto');
  const nombre = preview?.querySelector<HTMLElement>('.folio-preview__nombre');
  if (preview && video && pronto && nombre) {
    let activo: HTMLElement | null = null;
    const ocultar = () => {
      activo?.classList.remove('is-active');
      activo = null;
      preview.hidden = true;
      video.pause();
    };
    document.querySelectorAll<HTMLElement>('.folio-logo-wrap').forEach((logo) => {
      logo.addEventListener('mouseenter', () => {
        activo?.classList.remove('is-active');
        activo = logo;
        logo.classList.add('is-active');
        const r = logo.getBoundingClientRect();
        preview.style.transform = `translate(-50%,-100%) translate(${r.left + r.width / 2}px, ${r.top - 16}px)`;
        nombre.textContent = logo.dataset.name ?? '';
        const src = logo.dataset.video;
        pronto.hidden = Boolean(src);
        video.hidden = !src;
        if (src) {
          // Al saltar de un logo a otro sin salir, el video arranca de cero.
          if (video.getAttribute('src') !== src) video.src = src;
          video.currentTime = 0;
          video.play().catch(() => {});
        }
        preview.hidden = false;
      });
      logo.addEventListener('mouseleave', ocultar);
    });
  }
</script>
