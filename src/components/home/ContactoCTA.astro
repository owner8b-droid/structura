---
// Cierre de la home ("¿Listo para comenzar…?"), portado de
// legacy/Structura V2 - Home Content.dc.html.
import { t, path, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang).home.contacto;
---
<section id="contacto" style="padding:100px 5% 120px;max-width:1240px;margin:0 auto;">
  <div class="cta-grid">
    <div>
      <p style="font-family:'IBM Plex Mono',monospace;font-size:13px;color:#2DD4FF;letter-spacing:0.04em;margin:0 0 16px;">{d.eyebrow}</p>
      <h2 style="font-size:clamp(30px,4.4vw,46px);font-weight:700;letter-spacing:-0.01em;line-height:1.14;margin:0 0 20px;">{d.ctaTitleA} <span style="color:#2DD4FF;">{d.ctaTitleB}</span> <span style="color:#7C8894;">{d.ctaTitleC}</span></h2>
      <p style="color:#C9CFD6;font-size:17px;line-height:1.6;max-width:460px;margin:0 0 32px;">{d.ctaSub}</p>
      <div style="display:flex;gap:14px;flex-wrap:wrap;margin-bottom:36px;">
        <a href={path('contacto', lang)} class="btn-cta-primary">{d.ctaPrimary} ↗</a>
        <a href="#portafolio" class="btn-cta-ghost">{d.ctaSecondary} →</a>
      </div>
      <div style="border-top:1px solid #232B35;padding-top:24px;">
        <p style="color:#7C8894;font-size:13px;font-family:'IBM Plex Mono',monospace;margin:0 0 8px;">{d.ctaEmailLabel}</p>
        <a href={`mailto:${d.contactEmail}`} style="color:#E7ECEF;font-size:16px;font-weight:600;">{d.contactEmail}</a>
      </div>
    </div>

    <div style="display:flex;flex-direction:column;gap:16px;">
      {d.benefits.map((b, i) => (
        <div class="cta-benefit-card">
          <p style="font-family:'IBM Plex Mono',monospace;color:#2DD4FF;font-size:12px;letter-spacing:0.05em;margin:0 0 12px;">{String(i + 1).padStart(2, '0')}</p>
          <h3 style="margin:0 0 8px;font-size:18px;font-weight:600;">{b.title}</h3>
          <p style="color:#7C8894;font-size:14px;line-height:1.6;margin:0;">{b.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
