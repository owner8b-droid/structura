---
// Soluciones, portada de legacy/Structura V2 - Home Content.dc.html con el
// markup de los mockups tal cual. El título de cada tarjeta enlaza a la
// página de su servicio (Fase 3) y el link se estira para cubrir la tarjeta.
import { t, path, type Lang, type RouteKey } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang).home.soluciones;
const destinos: RouteKey[] = ['webMovil', 'ecommerce', 'hosting', 'iaAutomatizacion'];
---
<section id="soluciones" style="padding:120px 5% 100px;max-width:1240px;margin:0 auto;">
  <p style="font-family:'IBM Plex Mono',monospace;font-size:13px;color:#2DD4FF;letter-spacing:0.04em;margin:0 0 14px;">{d.eyebrow}</p>
  <h2 style="font-size:clamp(28px,4vw,44px);font-weight:600;letter-spacing:-0.01em;margin:0 0 16px;max-width:700px;">{d.title}</h2>
  <p style="color:#7C8894;font-size:17px;max-width:620px;line-height:1.6;margin:0 0 56px;">{d.sub}</p>

  <div class="sol-grid">

    <div class="sol-card" style="background:#10161D;border:1px solid #232B35;border-radius:16px;padding:28px;">
      <div class="sol-visual svc-visual svc-visual--web" aria-hidden="true" style="display:grid;grid-template-columns:1fr 1fr;">
        <div style="display:flex;flex-direction:column;overflow:hidden;">
          <div style="flex-shrink:0;display:flex;gap:5px;padding:7px 10px;background:#10161D;border-bottom:1px solid #232B35;">
            <span style="width:6px;height:6px;border-radius:50%;background:#FF5F57;"></span>
            <span style="width:6px;height:6px;border-radius:50%;background:#FEBC2E;"></span>
            <span style="width:6px;height:6px;border-radius:50%;background:#28C840;"></span>
          </div>
          <div style="flex:1;overflow:hidden;position:relative;">
            <div class="mock-cursor" style="position:absolute;width:8px;height:8px;border-radius:50%;background:#2DD4FF;box-shadow:0 0 0 4px rgba(45,212,255,0.15);z-index:2;pointer-events:none;"></div>
            <div class="browser-mock__scroll" style="display:flex;flex-direction:column;gap:10px;padding:10px;">
              <div style="display:flex;align-items:center;gap:6px;"><span style="width:7px;height:7px;border-radius:2px;background:#2DD4FF;"></span><span style="height:6px;width:28%;background:#232B35;border-radius:3px;"></span></div>
              <div style="display:flex;flex-direction:column;gap:5px;padding:4px 0;">
                <span style="height:7px;width:65%;background:#232B35;border-radius:4px;"></span>
                <span style="height:7px;width:45%;background:#232B35;border-radius:4px;"></span>
                <div class="mini-pill" style="width:46px;height:12px;background:#2DD4FF;border-radius:20px;margin-top:3px;opacity:.85;"></div>
              </div>
              <div style="display:flex;flex-direction:column;gap:5px;">
                <span style="height:6px;width:32%;background:#232B35;border-radius:3px;"></span>
                <div style="display:flex;gap:6px;"><i style="flex:1;height:28px;background:#0A0E13;border:1px solid #232B35;border-radius:6px;"></i><i style="flex:1;height:28px;background:#0A0E13;border:1px solid #232B35;border-radius:6px;"></i></div>
              </div>
              <div style="display:flex;flex-direction:column;gap:5px;">
                <span style="height:6px;width:38%;background:#232B35;border-radius:3px;"></span>
                <div style="display:flex;gap:6px;"><i style="flex:1;height:28px;background:#0A0E13;border:1px solid #232B35;border-radius:6px;"></i><i style="flex:1;height:28px;background:#0A0E13;border:1px solid #232B35;border-radius:6px;"></i></div>
              </div>
            </div>
            <div style="position:absolute;left:0;right:0;bottom:0;height:26px;background:linear-gradient(180deg, rgba(22,29,38,0) 0%, #161D26 100%);pointer-events:none;z-index:3;"></div>
          </div>
        </div>
        <div style="display:flex;align-items:center;justify-content:center;border-left:1px solid #232B35;background:#10161D;">
          <div class="phone-mock">
            <div class="phone-mock__notch"></div>
            <div class="phone-mock__screen">
              <div class="phone-app-icon"><i></i><i></i><i></i><i></i></div>
              <svg class="phone-splash-logo" viewBox="0 0 34 34" xmlns="http://www.w3.org/2000/svg">
                <rect x="2" y="2" width="14" height="14" fill="none" stroke="#2DD4FF" stroke-width="2.4"/>
                <rect x="18" y="18" width="14" height="14" fill="#2DD4FF"/>
                <rect x="18" y="2" width="14" height="14" fill="none" stroke="#7C8894" stroke-width="1.8"/>
              </svg>
            </div>
          </div>
        </div>
      </div>
      <p style="font-family:'IBM Plex Mono',monospace;color:#2DD4FF;font-size:13px;margin:0 0 8px;">01</p>
      <h3 style="margin:0 0 10px;font-size:19px;font-weight:600;"><a href={path(destinos[0], lang)} class="sol-card-link">{d.cards[0].title}</a></h3>
      <p style="color:#7C8894;font-size:14.5px;line-height:1.6;margin:0;">{d.cards[0].desc}</p>
    </div>

    <div class="sol-card" style="background:#10161D;border:1px solid #232B35;border-radius:16px;padding:28px;">
      <div class="sol-visual svc-visual svc-visual--saas" aria-hidden="true" style="display:flex;flex-direction:column;justify-content:center;gap:6px;padding:14px 22px;">
        <div style="display:flex;align-items:center;gap:8px;"><span style="width:6px;height:6px;border-radius:50%;background:#2DD4FF;animation:livePulse 2s ease-in-out infinite;"></span><span style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#7C8894;">{d.inventario}</span></div>
        <div style="height:13px;background:#0A0E13;border-radius:5px;display:flex;align-items:center;padding:0 8px;"><div style="height:4px;width:55%;background:#232B35;border-radius:2px;"></div></div>
        <div style="height:13px;background:#0A0E13;border-radius:5px;display:flex;align-items:center;padding:0 8px;"><div style="height:4px;width:40%;background:#232B35;border-radius:2px;"></div></div>
        <div class="dash-row--new" style="height:13px;background:rgba(45,212,255,0.1);border:1px solid rgba(45,212,255,0.3);border-radius:5px;display:flex;align-items:center;padding:0 8px;"><div style="height:4px;width:60%;background:#2DD4FF;border-radius:2px;"></div></div>
        <div class="dash-toast" style="background:rgba(45,212,255,0.12);border:1px solid #2DD4FF;color:#2DD4FF;font-family:'IBM Plex Mono',monospace;font-size:10px;text-align:center;padding:4px 8px;border-radius:5px;margin-top:2px;">{d.toast}</div>
      </div>
      <p style="font-family:'IBM Plex Mono',monospace;color:#2DD4FF;font-size:13px;margin:0 0 8px;">02</p>
      <h3 style="margin:0 0 10px;font-size:19px;font-weight:600;"><a href={path(destinos[1], lang)} class="sol-card-link">{d.cards[1].title}</a></h3>
      <p style="color:#7C8894;font-size:14.5px;line-height:1.6;margin:0;">{d.cards[1].desc}</p>
    </div>

    <div class="sol-card" style="background:#10161D;border:1px solid #232B35;border-radius:16px;padding:28px;">
      <div class="sol-visual" aria-hidden="true" style="display:flex;align-items:center;justify-content:center;">
        <svg width="100%" height="112" viewBox="0 0 220 112">
          <path d="M58 56 L162 56" stroke="#232B35" stroke-width="1" stroke-dasharray="4 6" class="hub-mini-base"/>
          <path d="M58 56 L162 56" stroke="#2DD4FF" stroke-width="1.8" stroke-linecap="round" class="db-mini-energy"/>
          <g transform="translate(34,56)">
            <path d="M-18,-22 a18,6 0 1,0 36,0 a18,6 0 1,0 -36,0" fill="none" stroke="#2DD4FF" stroke-width="1.5"/>
            <path d="M-18,-22 v34 a18,6 0 0,0 36,0 v-34" fill="none" stroke="#2DD4FF" stroke-width="1.5"/>
            <path d="M-18,-8 a18,6 0 0,0 36,0" fill="none" stroke="#232B35" stroke-width="1.2"/>
            <path d="M-18,6 a18,6 0 0,0 36,0" fill="none" stroke="#232B35" stroke-width="1.2"/>
          </g>
          <g transform="translate(178,56)">
            <circle r="9" fill="none" stroke="#2DD4FF" stroke-width="1.4" class="db-ping"/>
            <rect x="-9" y="-9" width="9" height="9" fill="none" stroke="#2DD4FF" stroke-width="1.3"/>
            <rect x="0" y="0" width="9" height="9" fill="#2DD4FF"/>
            <rect x="0" y="-9" width="9" height="9" fill="none" stroke="#7C8894" stroke-width="1"/>
          </g>
        </svg>
      </div>
      <p style="font-family:'IBM Plex Mono',monospace;color:#2DD4FF;font-size:13px;margin:0 0 8px;">03</p>
      <h3 style="margin:0 0 10px;font-size:19px;font-weight:600;"><a href={path(destinos[2], lang)} class="sol-card-link">{d.cards[2].title}</a></h3>
      <p style="color:#7C8894;font-size:14.5px;line-height:1.6;margin:0;">{d.cards[2].desc}</p>
    </div>

    <div class="sol-card" style="background:#10161D;border:1px solid #232B35;border-radius:16px;padding:28px;">
      <div class="sol-visual" aria-hidden="true" style="display:flex;align-items:center;justify-content:center;">
        <svg width="100%" height="136" viewBox="0 0 220 136">
          <path d="M110 68 L58 40" stroke="#232B35" stroke-width="1" stroke-dasharray="4 6" class="hub-mini-base"/>
          <path d="M110 68 L162 40" stroke="#232B35" stroke-width="1" stroke-dasharray="4 6" class="hub-mini-base"/>
          <path d="M110 68 L58 96" stroke="#232B35" stroke-width="1" stroke-dasharray="4 6" class="hub-mini-base"/>
          <path d="M110 68 L162 96" stroke="#232B35" stroke-width="1" stroke-dasharray="4 6" class="hub-mini-base"/>

          <path d="M110 68 L58 40" stroke="#2DD4FF" stroke-width="1.5" stroke-linecap="round" class="hub-mini-energy" style="animation-delay:0s;"/>
          <path d="M110 68 L162 40" stroke="#2DD4FF" stroke-width="1.5" stroke-linecap="round" class="hub-mini-energy" style="animation-delay:.2s;"/>
          <path d="M110 68 L58 96" stroke="#2DD4FF" stroke-width="1.5" stroke-linecap="round" class="hub-mini-energy" style="animation-delay:.4s;"/>
          <path d="M110 68 L162 96" stroke="#2DD4FF" stroke-width="1.5" stroke-linecap="round" class="hub-mini-energy" style="animation-delay:.6s;"/>

          <circle cx="110" cy="68" r="18" fill="#2DD4FF" opacity="0.14" style="filter:blur(7px);animation:livePulse 2.4s ease-in-out infinite;"/>
          <g class="hub-mini-core" transform="translate(110,68)">
            <rect x="-11" y="-11" width="10" height="10" fill="none" stroke="#2DD4FF" stroke-width="1.4"/>
            <rect x="1" y="1" width="10" height="10" fill="#2DD4FF"/>
            <rect x="1" y="-11" width="10" height="10" fill="none" stroke="#7C8894" stroke-width="1"/>
          </g>

          <g class="hub-mini-node" style="animation-delay:0s;" transform="translate(58,40)">
            <rect x="-8" y="-6" width="16" height="11" rx="3" fill="none" stroke="#2DD4FF" stroke-width="1.4"/>
            <path d="M-3 5 L-5 9 L1 5 Z" fill="#2DD4FF"/>
            <circle cx="-3.5" cy="-0.5" r="1" fill="#2DD4FF"/><circle cx="0" cy="-0.5" r="1" fill="#2DD4FF"/><circle cx="3.5" cy="-0.5" r="1" fill="#2DD4FF"/>
          </g>
          <g class="hub-mini-node" style="animation-delay:.3s;" transform="translate(162,40)">
            <line x1="0" y1="-10" x2="0" y2="-7" stroke="#2DD4FF" stroke-width="1.2"/><circle cx="0" cy="-11" r="1.3" fill="#2DD4FF"/>
            <rect x="-8" y="-7" width="16" height="13" rx="3" fill="none" stroke="#2DD4FF" stroke-width="1.4"/>
            <circle cx="-3.5" cy="-1" r="1.3" fill="#2DD4FF"/><circle cx="3.5" cy="-1" r="1.3" fill="#2DD4FF"/>
            <path d="M-3 3.5 Q0 5.5 3 3.5" stroke="#2DD4FF" stroke-width="1.1" fill="none"/>
          </g>
          <g class="hub-mini-node" style="animation-delay:.6s;" transform="translate(58,96)">
            <rect x="-7" y="1" width="4" height="6" fill="#2DD4FF"/>
            <rect x="-1.5" y="-3" width="4" height="10" fill="#2DD4FF"/>
            <rect x="4" y="-7" width="4" height="14" fill="#2DD4FF"/>
          </g>
          <g class="hub-mini-node" style="animation-delay:.9s;" transform="translate(162,96)">
            <rect x="-8" y="-8" width="16" height="16" rx="2" fill="none" stroke="#2DD4FF" stroke-width="1.4"/>
            <line x1="-8" y1="-2.7" x2="8" y2="-2.7" stroke="#2DD4FF" stroke-width="1"/>
            <line x1="-8" y1="2.7" x2="8" y2="2.7" stroke="#2DD4FF" stroke-width="1"/>
            <line x1="-2.7" y1="-8" x2="-2.7" y2="8" stroke="#2DD4FF" stroke-width="1"/>
            <line x1="2.7" y1="-8" x2="2.7" y2="8" stroke="#2DD4FF" stroke-width="1"/>
          </g>
        </svg>
      </div>
      <p style="font-family:'IBM Plex Mono',monospace;color:#2DD4FF;font-size:13px;margin:0 0 8px;">04</p>
      <h3 style="margin:0 0 10px;font-size:19px;font-weight:600;"><a href={path(destinos[3], lang)} class="sol-card-link">{d.cards[3].title}</a></h3>
      <p style="color:#7C8894;font-size:14.5px;line-height:1.6;margin:0;">{d.cards[3].desc}</p>
    </div>

  </div>
</section>

<style>
  .sol-card {
    position: relative;
  }
  .sol-card-link,
  .sol-card-link:hover {
    color: inherit;
  }
  .sol-card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 16px;
  }
  .sol-card-link:focus-visible {
    outline: none;
  }
  .sol-card:has(.sol-card-link:focus-visible) {
    outline: 2px solid #2DD4FF;
    outline-offset: 4px;
  }
</style>
