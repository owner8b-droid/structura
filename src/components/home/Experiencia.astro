---
// Experiencia por sector, portada de legacy/Structura V2 - Home Content.dc.html.
// Cada foto tiene un alt que la describe (antes repetía el título).
import { Picture } from 'astro:assets';
import legal from '../../assets/experiencia/legal.jpg';
import bienesraices from '../../assets/experiencia/bienesraices.jpg';
import agro from '../../assets/experiencia/agro.jpg';
import creativos from '../../assets/experiencia/creativos.jpg';
import serviciosProfesionales from '../../assets/experiencia/servicios-profesionales.webp';
import retailEcommerce from '../../assets/experiencia/retail-ecommerce.jpg';
import { t, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang).home.experiencia;
const fotos = [legal, bienesraices, agro, creativos, serviciosProfesionales, retailEcommerce];
---
<section id="experiencia" style="padding:0 5% 120px;max-width:1240px;margin:0 auto;">
  <p style="font-family:'IBM Plex Mono',monospace;font-size:13px;color:#2DD4FF;letter-spacing:0.04em;margin:0 0 14px;">{d.eyebrow}</p>
  <h2 style="font-size:clamp(28px,4vw,44px);font-weight:600;letter-spacing:-0.01em;margin:0 0 16px;max-width:640px;">{d.title}</h2>
  <p style="color:#7C8894;font-size:17px;max-width:600px;line-height:1.6;margin:0 0 56px;">{d.sub}</p>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px;margin-bottom:48px;">
    {d.cards.map((card, i) => (
      <div style="background:#10161D;border:1px solid #232B35;border-radius:16px;overflow:hidden;">
        <div style="height:140px;overflow:hidden;">
          {/* Se ven al ancho de la tarjeta: ~400 px en escritorio, casi todo el ancho en celular. */}
          <Picture src={fotos[i]} formats={['avif', 'webp']} fallbackFormat="jpg" widths={[400, 800]} sizes="(max-width: 700px) 90vw, 400px" loading="lazy" decoding="async" alt={card.imgAlt} style="width:100%;height:100%;object-fit:cover;display:block;" pictureAttributes={{ style: 'display:contents' }} />
        </div>
        <div style="padding:22px;">
          <p style="font-family:'IBM Plex Mono',monospace;color:#2DD4FF;font-size:12px;margin:0 0 8px;">{String(i + 1).padStart(2, '0')}</p>
          <h3 style="margin:0 0 8px;font-size:18px;font-weight:600;">{card.title}</h3>
          <p style="color:#7C8894;font-size:14px;line-height:1.6;margin:0 0 14px;">{card.desc}</p>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">{card.tags.map((tag) => <span style="font-size:12px;color:#7C8894;background:#161D26;border:1px solid #232B35;border-radius:6px;padding:4px 10px;">{tag}</span>)}</div>
        </div>
      </div>
    ))}
  </div>

  <div style="border-top:1px solid #232B35;padding-top:32px;">
    <p style="font-size:13px;color:#7C8894;margin:0 0 12px;">{d.alsoWorkedIn}</p>
    <div style="display:flex;gap:10px;flex-wrap:wrap;">
      {d.otherTags.map((tag) => <span style="font-size:13px;color:#C9CFD6;background:#10161D;border:1px solid #232B35;border-radius:20px;padding:8px 16px;">{tag}</span>)}
    </div>
  </div>
</section>
