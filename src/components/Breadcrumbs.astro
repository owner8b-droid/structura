---
// Ruta de navegación de las subpáginas (Inicio / … / página actual). El
// JSON-LD BreadcrumbList va en la Fase 6.
interface Props {
  label: string;
  items: { href?: string; label: string }[];
}

const { label, items } = Astro.props;
---
<nav aria-label={label} class="breadcrumbs">
  <ol>
    {items.map((item, i) => (
      <li>
        {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
        {i < items.length - 1 && <span aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  ol {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12.5px;
    color: #7C8894;
  }
  li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  a {
    color: #7C8894;
  }
  a:hover {
    color: #2DD4FF;
  }
  [aria-current] {
    color: #C9CFD6;
  }
</style>
