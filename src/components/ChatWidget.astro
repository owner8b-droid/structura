---
// Burbuja y panel del chat portados de legacy/Structura V2.dc.html. La lógica
// (src/scripts/chat.ts) se descarga recién con el primer click en la burbuja.
// La burbuja pasó de <a href="javascript:void(0)"> a <button> (border y
// padding en 0 para que se vea igual).
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t(lang).chat;
---
<button type="button" id="ai-widget-toggle" aria-label={c.toggle} aria-expanded="false" aria-controls="ai-widget-panel" class="chat-bubble" style="position:fixed;right:24px;bottom:24px;z-index:150;width:56px;height:56px;border-radius:50%;background:#2DD4FF;color:#0A0E13;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 24px rgba(45,212,255,0.35);border:none;padding:0;cursor:pointer;">
  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
</button>

<div id="ai-widget-panel" aria-hidden="true" data-lang={lang} data-typing={c.typing} data-error-reply={c.errorReply} data-error-connection={c.errorConnection} data-whatsapp-cta={c.whatsappCta}>
  <div class="ai-widget-header">
    <span>{c.title}</span>
    <button type="button" id="ai-widget-close" aria-label={c.close}>&times;</button>
  </div>
  <div id="ai-widget-messages" class="ai-widget-messages">
    <div class="ai-widget-msg ai-widget-msg--bot">{c.greeting}</div>
  </div>
  <form id="ai-widget-form" class="ai-widget-form">
    <input id="ai-widget-input" type="text" placeholder={c.placeholder} autocomplete="off" maxlength="1000" />
    <button type="submit" aria-label={c.send}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
    </button>
  </form>
</div>

<script>
  // El JavaScript del chat se descarga con el primer click en la burbuja: la
  // mayoría de las visitas nunca lo abre.
  document.getElementById('ai-widget-toggle')?.addEventListener(
    'click',
    () => {
      import('../scripts/chat').then((m) => m.iniciarChat());
    },
    { once: true },
  );
</script>
